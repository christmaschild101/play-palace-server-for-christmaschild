# Tic-Tac-Toe game messages

# Game info
game-name-tictactoe = Tic-Tac-Toe

# Moves
tictactoe-move = { $player } places { $mark } at { $coord }.
tictactoe-winner = { $player } wins with three { $mark }s in a row!
tictactoe-draw = It's a draw!

# Turns
tictactoe-your-turn = Your turn, you are { $mark }.
tictactoe-turn-start = { $player }'s turn ({ $mark }).

# Grid cells
tictactoe-cell-empty = { $coord }, empty
