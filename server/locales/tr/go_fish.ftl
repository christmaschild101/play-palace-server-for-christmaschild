# Go Fish card game messages

# Game info
game-name-go_fish = Go Fish

# Actions
gofish-ask = Ask for a rank
gofish-ask-rank = Ask for { $rank } from…
gofish-ask-whom = Ask a player
gofish-pick-rank = Which rank do you want to ask for?
gofish-pick-player = Ask whom?

# Dealing
gofish-dealt = Everyone gets { $cards } cards. Good luck!

# Queries
gofish-book = { $player } made a book of { $rank }s!
gofish-gave = { $target } gives { $asker } { $count } { $rank }s!
gofish-go-fish = { $player } asks { $target } for { $rank }s… Go fish!
gofish-fished-wanted = { $player } drew the { $rank } they asked for, and asks again!
gofish-fished = { $player } drew a card, but it wasn't the { $rank } they wanted.
gofish-ask-again = You ask again!

# Disabled reasons
gofish-no-cards = You have no cards to ask with.
gofish-pick-rank-first = Pick a rank first.

# Game end
gofish-winner-books = { $player } wins with { $books } books!
gofish-winner = { $player } wins with { $books } books!
gofish-tie = { $players } tie with { $books } books each!
gofish-score-line = { $player }: { $books } books

# Options
gofish-set-books = Books to win: { $books }
gofish-desc-books = Number of books needed to win immediately
gofish-enter-books = Enter books needed to win:
gofish-option-changed-books = Books to win set to { $books }.